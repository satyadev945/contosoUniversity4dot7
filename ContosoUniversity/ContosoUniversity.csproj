<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ContosoUniversity</RootNamespace>
    <AssemblyName>ContosoUniversity</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework 6 migration resources are matched to their migration classes -->
    <EmbeddedResource Update="Migrations\201704071734334_InitialCreate.resx">
      <DependentUpon>201704071734334_InitialCreate.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Migrations\201704071912244_MaxLengthOnNames.resx">
      <DependentUpon>201704071912244_MaxLengthOnNames.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Migrations\201704071918357_ColumnFirstName.resx">
      <DependentUpon>201704071918357_ColumnFirstName.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Migrations\201704072018206_additions.resx">
      <DependentUpon>201704072018206_additions.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Migrations\201704072023555_ComplexDataModel.resx">
      <DependentUpon>201704072023555_ComplexDataModel.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Migrations\201704072033529_Initial.resx">
      <DependentUpon>201704072033529_Initial.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
