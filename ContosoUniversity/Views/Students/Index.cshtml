@model PaginatedList<ContosoUniversity.Models.Student>

@{
    ViewBag.Title = "Students";
    var currentSort = ViewData["CurrentSort"] as string;
    var currentFilter = ViewData["CurrentFilter"] as string;
}

<h2>Students</h2>
<br />
<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
<br />
<form asp-action="Index" method="get">
    <p>
        <b>Find by name:</b> <input type="text" name="SearchString" value="@currentFilter" />
        <input class="btn" type="submit" value="Search" />
    </p><br />
</form>
<table class="table">
    <tr>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-currentFilter="@currentFilter">Last Name</a>
        </th>
        <th>
            First Name
        </th>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]" asp-route-currentFilter="@currentFilter">Enrollment Date</a>
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.LastName)</td>
            <td>@Html.DisplayFor(modelItem => item.FirstMidName)</td>
            <td>@Html.DisplayFor(modelItem => item.EnrollmentDate)</td>
            <td>
                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.ID">Edit</a>
                <a class="btn btn-info" asp-action="Details" asp-route-id="@item.ID">Details</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
    }

</table>
<br />
Page @(Model.TotalPages < Model.PageIndex ? 0 : Model.PageIndex) of @Model.TotalPages

@if (Model.TotalPages > 1)
{
    <ul class="pagination">
        <li class="@(Model.HasPreviousPage ? "" : "disabled")">
            @if (Model.HasPreviousPage)
            {
                <a asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-sortOrder="@currentSort" asp-route-currentFilter="@currentFilter">&laquo; Previous</a>
            }
            else
            {
                <span>&laquo; Previous</span>
            }
        </li>
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
        {
            <li class="@(pageNumber == Model.PageIndex ? "active" : "")">
                <a asp-action="Index" asp-route-page="@pageNumber" asp-route-sortOrder="@currentSort" asp-route-currentFilter="@currentFilter">@pageNumber</a>
            </li>
        }
        <li class="@(Model.HasNextPage ? "" : "disabled")">
            @if (Model.HasNextPage)
            {
                <a asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-sortOrder="@currentSort" asp-route-currentFilter="@currentFilter">Next &raquo;</a>
            }
            else
            {
                <span>Next &raquo;</span>
            }
        </li>
    </ul>
}
