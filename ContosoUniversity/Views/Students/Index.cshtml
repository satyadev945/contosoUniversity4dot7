@model PaginatedList<ContosoUniversity.Models.Student>

@{
    ViewBag.Title = "Students";
    var currentSort = ViewBag.CurrentSort as string;
    var currentFilter = ViewBag.CurrentFilter as string;
}

<link href="~/css/PagedList.css" rel="stylesheet" type="text/css" />

<h2>Students</h2>
<br />
<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<br />
<form asp-action="Index" asp-controller="Students" method="get">
    <p>
        <b>Find by name:</b> <input type="text" name="SearchString" value="@currentFilter" />
        <input class="btn" type="submit" value="Search" />
    </p><br />
</form>
<table class="table">
    <tr>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSortParm" asp-route-currentFilter="@currentFilter">Last Name</a>
        </th>
        <th>
            First Name
        </th>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.DateSortParm" asp-route-currentFilter="@currentFilter">Enrollment Date</a>
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FirstMidName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EnrollmentDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }

</table>
<br />
Page @(Model.TotalPages < Model.PageIndex ? 0 : Model.PageIndex) of @Model.TotalPages

@if (Model.TotalPages > 1)
{
    <ul class="pagination">
        <li class="@(Model.HasPreviousPage ? "" : "disabled PagedList-skipToPrevious")">
            <a asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-sortOrder="@currentSort" asp-route-currentFilter="@currentFilter">&laquo;</a>
        </li>
        @for (var p = 1; p <= Model.TotalPages; p++)
        {
            <li class="@(p == Model.PageIndex ? "active" : "")">
                <a asp-action="Index" asp-route-page="@p" asp-route-sortOrder="@currentSort" asp-route-currentFilter="@currentFilter">@p</a>
            </li>
        }
        <li class="@(Model.HasNextPage ? "" : "disabled PagedList-skipToNext")">
            <a asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-sortOrder="@currentSort" asp-route-currentFilter="@currentFilter">&raquo;</a>
        </li>
    </ul>
}
