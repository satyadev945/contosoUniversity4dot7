@model ContosoUniversity.ViewModels.PaginatedList<ContosoUniversity.Models.Student>

@{
    ViewBag.Title = "Students";
}

<h2>Students</h2>
<br />
<p>
    <button class="btn btn-primary" onClick="location.href ='@Url.Action("Create", "Students")';return false;">Create New</button>
   
</p>
<br />
<form asp-action="Index" method="get">
    <p>
        <b>Find by name:</b> <input type="text" name="SearchString" value="@(ViewBag.CurrentFilter as string)" />
        <input class="btn" type="submit" value="Search" />
    </p><br />
</form>
<table class="table">
    <tr>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSortParm" asp-route-currentFilter="@ViewBag.CurrentFilter">Last Name</a>
        </th>
        <th>
            First Name
        </th>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.DateSortParm" asp-route-currentFilter="@ViewBag.CurrentFilter">Enrollment Date</a>
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FirstMidName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EnrollmentDate)
            </td>
            <td>
                <button class="btn btn-warning" onClick="location.href =' @Url.Action("Edit", "Students", new { id = item.ID })';return false;">Edit</button>
                <button class="btn btn-info" onClick="location.href =' @Url.Action("Details", "Students", new { id = item.ID })';return false;">Details</button>
                <button class="btn btn-danger" onClick="location.href =' @Url.Action("Delete", "Students", new { id = item.ID })';return false;">Delete</button>
               
            </td>
        </tr>
    }

</table>
<br />
Page @(Model.TotalPages < Model.PageIndex ? 0 : Model.PageIndex) of @Model.TotalPages

<ul class="pagination">
    @if (Model.HasPreviousPage)
    {
        <li><a asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-sortOrder="@ViewBag.CurrentSort" asp-route-currentFilter="@ViewBag.CurrentFilter">&laquo; Previous</a></li>
    }
    else
    {
        <li class="disabled"><span>&laquo; Previous</span></li>
    }
    @for (var i = 1; i <= Model.TotalPages; i++)
    {
        <li class="@(i == Model.PageIndex ? "active" : "")"><a asp-action="Index" asp-route-page="@i" asp-route-sortOrder="@ViewBag.CurrentSort" asp-route-currentFilter="@ViewBag.CurrentFilter">@i</a></li>
    }
    @if (Model.HasNextPage)
    {
        <li><a asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-sortOrder="@ViewBag.CurrentSort" asp-route-currentFilter="@ViewBag.CurrentFilter">Next &raquo;</a></li>
    }
    else
    {
        <li class="disabled"><span>Next &raquo;</span></li>
    }
</ul>
