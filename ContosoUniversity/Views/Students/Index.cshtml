@model PaginatedList<ContosoUniversity.Models.Student>
<link href="~/css/PagedList.css" rel="stylesheet" type="text/css" />

@{
    ViewBag.Title = "Students";
    var currentSort = ViewData["CurrentSort"] as string;
    var currentFilter = ViewData["CurrentFilter"] as string;
}

<h2>Students</h2>
<br />
<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
<br />
<form asp-action="Index" method="get">
    <p>
        <b>Find by name:</b> <input type="text" name="SearchString" value="@currentFilter" />
        <input class="btn" type="submit" value="Search" />
    </p><br />
</form>
<table class="table">
    <tr>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-currentFilter="@currentFilter">Last Name</a>
        </th>
        <th>
            First Name
        </th>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]" asp-route-currentFilter="@currentFilter">Enrollment Date</a>
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FirstMidName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EnrollmentDate)
            </td>
            <td>
                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.ID">Edit</a>
                <a class="btn btn-info" asp-action="Details" asp-route-id="@item.ID">Details</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
    }

</table>
<br />
Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

@if (Model.PageCount > 1)
{
    <ul class="pagination">
        <li class="@(Model.HasPreviousPage ? "" : "disabled")">
            <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-sortOrder="@currentSort" asp-route-currentFilter="@currentFilter">&laquo; Prev</a>
        </li>
        @for (var i = 1; i <= Model.PageCount; i++)
        {
            <li class="@(i == Model.PageNumber ? "active" : "")">
                <a asp-action="Index" asp-route-page="@i" asp-route-sortOrder="@currentSort" asp-route-currentFilter="@currentFilter">@i</a>
            </li>
        }
        <li class="@(Model.HasNextPage ? "" : "disabled")">
            <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-sortOrder="@currentSort" asp-route-currentFilter="@currentFilter">Next &raquo;</a>
        </li>
    </ul>
}
