@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ContosoUniversity.Models.Student>

@{
    ViewBag.Title = "Students";
}

<link href="~/css/PagedList.css" rel="stylesheet" type="text/css" />

<h2>Students</h2>
<br />
<p>
    <a class="btn btn-primary" asp-controller="Students" asp-action="Create">Create New</a>
</p>
<br />
<form asp-controller="Students" asp-action="Index" method="get">
    <p>
        <b>Find by name:</b> <input type="text" name="searchString" value="@(ViewBag.CurrentFilter as string)" />
        <input class="btn" type="submit" value="Search" />
    </p><br />
</form>
<table class="table">
    <tr>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSortParm" asp-route-currentFilter="@ViewBag.CurrentFilter">Last Name</a>
        </th>
        <th>
            First Name
        </th>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.DateSortParm" asp-route-currentFilter="@ViewBag.CurrentFilter">Enrollment Date</a>
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FirstMidName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EnrollmentDate)
            </td>
            <td>
                <a class="btn btn-warning" asp-controller="Students" asp-action="Edit" asp-route-id="@item.ID">Edit</a>
                <a class="btn btn-info" asp-controller="Students" asp-action="Details" asp-route-id="@item.ID">Details</a>
                <a class="btn btn-danger" asp-controller="Students" asp-action="Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
    }

</table>
<br />
Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("Index",
    new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }))
