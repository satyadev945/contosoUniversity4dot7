@model ContosoUniversity.Services.PaginatedList<ContosoUniversity.Models.Student>

@{
    ViewBag.Title = "Students";
}

<h2>Students</h2>
<br />
<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
<br />
<form asp-action="Index" method="get">
    <p>
        <b>Find by name:</b> <input type="text" name="SearchString" value="@(ViewBag.CurrentFilter as string)" />
        <input class="btn" type="submit" value="Search" />
    </p><br />
</form>
<table class="table">
    <tr>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSortParm" asp-route-currentFilter="@ViewBag.CurrentFilter">Last Name</a>
        </th>
        <th>
            First Name
        </th>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.DateSortParm" asp-route-currentFilter="@ViewBag.CurrentFilter">Enrollment Date</a>
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FirstMidName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EnrollmentDate)
            </td>
            <td>
                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.ID">Edit</a>
                <a class="btn btn-info" asp-action="Details" asp-route-id="@item.ID">Details</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
    }
</table>
<br />
Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

@if (Model.PageCount > 1)
{
    <ul class="pagination">
        <li class="@(Model.HasPreviousPage ? "" : "disabled")">
            <a asp-action="Index"
               asp-route-page="@(Model.PageNumber - 1)"
               asp-route-sortOrder="@ViewBag.CurrentSort"
               asp-route-currentFilter="@ViewBag.CurrentFilter">&laquo;</a>
        </li>
        @for (var p = 1; p <= Model.PageCount; p++)
        {
            <li class="@(p == Model.PageNumber ? "active" : "")">
                <a asp-action="Index"
                   asp-route-page="@p"
                   asp-route-sortOrder="@ViewBag.CurrentSort"
                   asp-route-currentFilter="@ViewBag.CurrentFilter">@p</a>
            </li>
        }
        <li class="@(Model.HasNextPage ? "" : "disabled")">
            <a asp-action="Index"
               asp-route-page="@(Model.PageNumber + 1)"
               asp-route-sortOrder="@ViewBag.CurrentSort"
               asp-route-currentFilter="@ViewBag.CurrentFilter">&raquo;</a>
        </li>
    </ul>
}
